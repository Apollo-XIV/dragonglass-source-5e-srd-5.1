      {
        "id": "colossus-slayer",
        "name": "Colossus Slayer",
        "activation": "special",
        "damage": "1d8",
        "provenance": {
          "source": "pack:release-5.3.3",
          "review": "auto"
        }
      }
    ]
  },
  {
